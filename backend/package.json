    "zod": "^4.1.12",
    "@prisma/client": "^6.16.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.1",
    "prisma": "^6.16.3",
    "tsx": "^4.20.6",
